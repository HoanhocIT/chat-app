# Cổng chạy ứng dụng (Render/Railway tự cấp PORT ngẫu nhiên)
PORT=5000

# Chuỗi kết nối MongoDB Atlas (Thay bằng chuỗi kết nối của bạn nếu cần)
MONGO_URI=mongodb+srv://chatappadmin:Hoan11042005@cluster0.qweu9l7.mongodb.net/chatapp?retryWrites=true&w=majority

# Khóa bí mật JWT dùng để ký và xác thực token đăng nhập
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-bi-mat-ngau-nhien-that-dai-chat-app-2026

# Thời hạn token
JWT_EXPIRES_IN=7d

# URL Client (Tùy chọn, để trống nếu dùng chung domain backend + frontend)
CLIENT_URL=

# Cấu hình gửi Email Quên Mật Khẩu:
# Cách 1 (Khuyên dùng trên Render): Dùng Resend HTTP API (Cổng 443 không bao giờ bị chặn, miễn phí 3000 mail/tháng tại resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

# Cách 2: Dùng Gmail App Password qua SMTP (Hoạt động tốt khi test local / VPS)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-gmail-app-password
